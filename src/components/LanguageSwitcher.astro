---
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = config.site.lang;
const t = useTranslations(locale);
---

<div id="language-switcher" class="relative">
  <button
    id="lang-btn"
    class="neu-button size-8 text-xs font-medium text-[var(--neu-text)]"
    aria-label={t.language.switchLang}
    title={t.language.switchLang}
  >
    <span id="lang-current">{t.language[locale as keyof typeof t.language]}</span>
  </button>
  <div
    id="lang-menu"
    class="absolute right-0 top-full mt-1 hidden min-w-[110px] rounded-lg border border-[var(--neu-border)] bg-[var(--neu-bg)] p-1 shadow-lg"
  >
    {["zh", "zh-TW", "en"].map((lang) => (
      <button
        class="lang-option block w-full rounded-md px-3 py-1.5 text-left text-sm hover:bg-[var(--neu-surface)] data-[active=true]:bg-[var(--neu-surface)] data-[active=true]:font-medium text-[var(--neu-text)]"
        data-lang={lang}
        data-active={lang === locale ? "true" : "false"}
      >
        {t.language[lang as keyof typeof t.language]}
      </button>
    ))}
  </div>
</div>

<script>
  import "@/scripts/language-switcher";
</script>
