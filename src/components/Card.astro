---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, tags, ...props } = data;

const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
---

<article class="neu-card p-6">
  <a href={postUrl} class="block">
    <Heading
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="text-xl font-semibold mb-3 hover:text-[var(--neu-accent)] transition-colors"
    >
      {title}
    </Heading>
  </a>
  <Datetime {...props} />
  <p class="mt-3 text-[var(--neu-text-muted)] leading-relaxed">
    {description}
  </p>
  {
    tags && tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <Tag tag={tag} />
        ))}
      </div>
    )
  }
</article>