---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, tags, pubDatetime } = data;

const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
---

<article class="post-card">
  <div class="post-card-header">
    <time>{pubDatetime.toLocaleDateString()}</time>
  </div>
  <h2>
    <a href={postUrl}>{title}</a>
  </h2>
  <p>{description}</p>
  {tags && tags.length > 0 && (
    <div class="post-card-tags">
      {tags.map((tag) => (
        <span class="post-card-tag">{tag}</span>
      ))}
    </div>
  )}
</article>
