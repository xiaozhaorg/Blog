---
import type { HTMLAttributes } from "astro/types";

type Props = { disabled?: boolean } & HTMLAttributes<"a">;

const { disabled, class: className, ...attrs } = Astro.props;

const Button = disabled ? "span" : "a";
---

<Button
  aria-disabled={disabled}
  class:list={[
    "inline-flex items-center gap-2 text-[var(--neu-text)] transition-colors",
    { "hover:text-[var(--neu-accent)]": !disabled },
    { "opacity-50 cursor-not-allowed": disabled },
    className,
  ]}
  {...attrs}
>
  <slot />
</Button>
