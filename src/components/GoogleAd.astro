---
import config from "@/config";

interface Props {
  slotId: string;
  format?: string;
  responsive?: boolean;
}

const { site } = config;
const { 
  slotId, 
  format = "auto", 
  responsive = true 
} = Astro.props;
---

{site.googleAdsense && (
  <>
    <ins
      class="adsbygoogle"
      style={{ display: "block" }}
      data-ad-client={site.googleAdsense}
      data-ad-slot={slotId}
      data-ad-format={format}
      data-full-width-responsive={responsive}
    ></ins>

    <script is:inline>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </>
)}