---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="neu-flat mt-8 p-6">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <div class="order-2 flex items-center gap-2 text-sm text-[var(--neu-text-muted)] sm:order-1">
        <span>{t.footer.copyright} &#169; {currentYear}</span>
        <span class="hidden sm:inline">|</span>
        <span>{t.footer.allRightsReserved}</span>
      </div>
      <div class="order-1 sm:order-2">
        <Socials />
      </div>
    </div>
  </div>
</footer>