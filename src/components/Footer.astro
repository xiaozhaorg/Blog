---
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = config.site.lang;
const t = useTranslations(locale);
---

<footer class="footer">
  <div class="footer-links">
    <a href="/">{t.nav.home}</a>
    <a href="/about">{t.nav.about}</a>
    <a href="/posts">{t.nav.posts}</a>
    <a href="/archives">{t.nav.archives}</a>
    <a href="/tags">{t.nav.tags}</a>
  </div>
  <p>
    © {new Date().getFullYear()} {t.site.title}. {t.footer.allRightsReserved}
  </p>
</footer>
