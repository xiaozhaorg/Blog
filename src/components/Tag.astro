---
import { getRelativeLocaleUrl } from "@/i18n/utils";
import config from "@/config";

type Props = {
  tag: string;
  tagName?: string;
};

const { tag, tagName } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "inline-block rounded-full px-4 py-1.5 text-sm font-medium transition-all",
      "neu-button",
      "hover:bg-[var(--neu-accent)] hover:text-white",
    ]}
  >
    #{tagName ?? tag}
  </a>
</li>