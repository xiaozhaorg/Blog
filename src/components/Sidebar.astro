---
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = config.site.lang;
const t = useTranslations(locale);

const currentPath = Astro.url.pathname;

const githubUrl = "https://github.com/xiaozhaorg";
---

<aside class="sidebar">
  <div class="sidebar-header">
    <div class="avatar">
      <img src="/xiaozha.png" alt="博主头像" />
    </div>
    <h2 class="sidebar-name">{t.site.title}</h2>
    <p class="sidebar-desc">一个白嫖cloud flare的个人博客</p>
  </div>
  
  <nav class="sidebar-nav">
    <ul>
      <li><a href="/" class:list={[{ active: currentPath === "/" }]}>{t.nav.home}</a></li>
      <li><a href="/posts" class:list={[{ active: currentPath.startsWith("/posts") }]}>{t.nav.posts}</a></li>
      <li><a href="/tags" class:list={[{ active: currentPath.startsWith("/tags") }]}>{t.nav.tags}</a></li>
      <li><a href="/archives" class:list={[{ active: currentPath === "/archives" }]}>{t.nav.archives}</a></li>
      <li><a href="/about" class:list={[{ active: currentPath === "/about" }]}>{t.nav.about}</a></li>
    </ul>
  </nav>
  
  <div class="sidebar-actions">
    <button id="theme-btn" class="sidebar-btn" aria-label="Toggle theme">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
    </button>
    <a href="/search" class="sidebar-btn" aria-label="Search">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </a>
    <a href={githubUrl} target="_blank" class="sidebar-btn" aria-label="GitHub">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 22v-4a4.86 4.86 0 0 0-1-3.75 4.38 4.38 0 0 0-.11-1.31L15 5.99a2.49 2.49 0 0 0-1.31-3.88 2.1 2.1 0 0 0-3.08 0 2.49 2.49 0 0 0-1.31 3.88l.11 1.25a4.38 4.38 0 0 0-.11 1.31 4.86 4.86 0 0 0-1 3.75v4M9 19c-1.67 0-3.34-.5-4.88-1.36L3 21l1.88-3.36A9.63 9.63 0 0 1 9 19m6 0c1.67 0 3.34.5 4.88 1.36L21 21l-1.88-3.36A9.63 9.63 0 0 0 15 19"></path>
      </svg>
    </a>
    <a href="/rss.xml" class="sidebar-btn" aria-label="RSS">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 11a9 9 0 0 1 9 9"></path>
        <path d="M4 4a16 16 0 0 1 16 16"></path>
        <circle cx="5" cy="19" r="1"></circle>
      </svg>
    </a>
  </div>
</aside>
