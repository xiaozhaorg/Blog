---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getRelativeLocaleUrl } from "@/i18n/utils";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center py-20"
  >
    <div class="neu-card p-12 text-center">
      <h1 class="text-8xl font-bold mb-4" style="color: var(--neu-accent);">
        404
      </h1>
      <p class="text-2xl mb-2">Oops! Page not found</p>
      <p class="text-[var(--neu-text-muted)] mb-8">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <LinkButton
        href={getRelativeLocaleUrl(locale, "")}
        class="neu-button px-8 py-4 text-lg font-medium"
      >
        {t.notFound.goHome}
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>