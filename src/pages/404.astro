---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getRelativeLocaleUrl } from "@/i18n/utils";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getCollection } from "astro:content";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, 5);
---

<Layout title={`404 | ${config.site.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center py-12"
  >
    <div class="max-w-4xl w-full px-6">
      <div class="neu-card p-12 text-center mb-8">
        <div class="relative inline-block mb-6">
          <svg
            viewBox="0 0 200 200"
            class="w-48 h-48 mx-auto animate-bounce"
            style="animation-duration: 2s;"
          >
            <circle cx="100" cy="100" r="80" fill="none" stroke="var(--neu-accent)" stroke-width="4" opacity="0.2"/>
            <circle cx="100" cy="100" r="60" fill="none" stroke="var(--neu-accent)" stroke-width="3" opacity="0.3"/>
            <circle cx="100" cy="100" r="40" fill="none" stroke="var(--neu-accent)" stroke-width="2" opacity="0.5"/>
            <text x="100" y="115" text-anchor="middle" font-size="60" font-weight="bold" fill="var(--neu-accent)">404</text>
          </svg>
          <div class="absolute -top-2 -right-2 w-10 h-10 bg-red-500 rounded-full flex items-center justify-center text-white font-bold animate-pulse">!</div>
        </div>
        
        <h2 class="text-3xl font-bold mb-3" style="color: var(--neu-accent);">
          哎呀，页面走丢了！
        </h2>
        <p class="text-lg text-[var(--neu-text-muted)] mb-6">
          你访问的页面不存在或已被移动，别担心，我们帮你找回来！
        </p>

        <div class="max-w-md mx-auto mb-8">
          <form
            action="/search/"
            method="get"
            class="flex gap-2"
          >
            <input
              type="text"
              name="q"
              placeholder="搜索文章..."
              class="flex-1 px-4 py-3 rounded-lg border-2 border-transparent bg-[var(--neu-bg-secondary)] focus:border-[var(--neu-accent)] focus:outline-none transition-all neu-input"
            />
            <button
              type="submit"
              class="px-6 py-3 rounded-lg bg-[var(--neu-accent)] text-white font-medium hover:opacity-90 transition-opacity neu-button"
            >
              搜索
            </button>
          </form>
        </div>

        <div class="flex flex-wrap justify-center gap-4">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "")}
            class="neu-button px-8 py-3 text-lg font-medium"
          >
            返回首页
          </LinkButton>
          <LinkButton
            href="/posts/"
            class="neu-button-secondary px-8 py-3 text-lg font-medium"
          >
            浏览文章
          </LinkButton>
        </div>
      </div>

      <div class="neu-card p-8">
        <h3 class="text-xl font-bold mb-6 text-center" style="color: var(--neu-accent);">
          热门文章推荐
        </h3>
        <ul class="space-y-3">
          {recentPosts.map((post) => {
            const slug = post.id.split("/").pop();
            return (
            <li>
              <a href={`/posts/${slug}/`} class="flex items-center gap-4 p-3 rounded-lg hover:bg-[var(--neu-bg-secondary)] transition-colors group">
                <svg class="w-5 h-5 text-[var(--neu-accent)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
                <div class="flex-1 min-w-0">
                  <h4 class="font-semibold truncate group-hover:text-[var(--neu-accent)] transition-colors">
                    {post.data.title}
                  </h4>
                  <p class="text-sm text-[var(--neu-text-muted)] truncate">
                    {post.data.description}
                  </p>
                </div>
                <span class="text-xs px-2 py-1 rounded-full bg-[var(--neu-bg-secondary)] text-[var(--neu-text-muted)] flex-shrink-0">
                  {new Date(post.data.pubDatetime).toLocaleDateString("zh-CN")}
                </span>
              </a>
            </li>
            );
          })}
        </ul>
      </div>

      <div class="text-center mt-8">
        <p class="text-sm text-[var(--neu-text-muted)]">
          还是没找到想要的内容？
          <a href="mailto:hi@xiaozha.org" class="text-[var(--neu-accent)] hover:underline ml-1">
            联系我
          </a>
          吧！
        </p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
